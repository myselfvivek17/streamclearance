# Gemini backend: Vertex AI when GOOGLE_CLOUD_PROJECT/GCP_PROJECT is set (ADC, e.g.
# GOOGLE_APPLICATION_CREDENTIALS=.secrets/gcp-sa.json), else AI Studio with GEMINI_API_KEY, else mock.
# GEMINI_API_KEY=
# SC_GEMINI_BACKEND=vertex|studio
# GCP_VERTEX_LOCATION=global
# Keep Gemini processing in Singapore (asia-southeast1 + gemini-2.5-flash; overrides the location)
# SC_DATA_RESIDENCY=sg
# SC_VERTEX_INLINE_MB=19
# SC_UPLOAD_BUCKET=<project>-sc-uploads
# SC_MAX_CALLS_PER_JOB=40
# Law search (Vertex AI RAG Engine; tools/index_laws.py builds it)
# SC_LAW_SEARCH=rag|bm25
# SC_SEARCH_STORE=streamclearance-laws
# SC_SEARCH_LOCATION=asia-southeast1
# SC_SEARCH_MAX_DISTANCE=0.6
# Optional model overrides
# SC_MODEL_FAST=gemini-3.8-flash
# SC_MODEL_SMART=gemini-3.8-flash
# Force mock mode even when a key is set
# SC_MOCK=1
# Require an access code on all /api routes (header X-Access-Code or cookie sc_access)
# SC_ACCESS_CODE=
# SC_PORT=8430
# SC_GEMINI_CONCURRENCY=2
# SC_MAX_UPLOAD_MB=200
# SC_MAX_DURATION_S=600
# SC_MOCK_DELAY=0.6
# Retention: unanalysed uploads are deleted after this many minutes, reports after this many days
# SC_UNUSED_VIDEO_TTL_MIN=60
# SC_REPORT_TTL_DAYS=7
# Shown on /privacy: Cloud Run region (deploy.sh sets it), and 1 once the project's Vertex AI cacheConfig has disableCache: true
# SC_APP_REGION=asia-southeast1
# SC_VERTEX_CACHE_DISABLED=1

# Google Cloud
GCP_PROJECT=booming-entity-510706-e9
GCP_REGION=asia-southeast1
